# Copy to .env and fill in. .env is gitignored and must never be committed.

APP_NAME=local-doc-ocr
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
# json in deployment, console for a readable local terminal
LOG_FORMAT=json

POSTGRES_HOST=db
POSTGRES_PORT=5432
# Owner role. Alembic connects with this one; the running app does not.
POSTGRES_USER=ocr
POSTGRES_PASSWORD=change-me-before-you-run-anything
POSTGRES_DB=doc_ocr
# Restricted runtime role the app connects as (app/db/session.py). Created and
# granted by the `add_app_role` migration -- it does not exist until you run
# `alembic upgrade head`. Cannot UPDATE or DELETE audit_logs.
POSTGRES_APP_USER=ocr_app
POSTGRES_APP_PASSWORD=change-me-a-different-password-than-the-owner
DB_ECHO=false

# Root for encrypted document storage (Phase 3).
DATA_DIR=/srv/data

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this invalidates every token in circulation. That is the intent.
JWT_SECRET_KEY=generate-me-do-not-ship-this-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
MIN_PASSWORD_LENGTH=12

# `id:base64key,id:base64key,...` -- a small key ring, not a single key.
# Generate a new id's key with:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# STORAGE_ENCRYPTION_KEY_CURRENT names which id new writes encrypt under.
# Rotating in a new id (add it here, bump the current below) does not brick
# documents already encrypted under an older id -- keep old ids listed as long
# as any stored document still needs them to decrypt. Back up this value
# separately from the ciphertext. The current key is rejected at startup
# outside ENVIRONMENT=local if it is still this placeholder -- shipping it
# unchanged means anyone with the repo can decrypt every document. BitLocker,
# not this variable's storage location, is the control against device theft:
# the key sits in .env on the same disk as the ciphertext either way.
STORAGE_ENCRYPTION_KEYS=v1:generate-me-32-random-bytes-base64-encoded
STORAGE_ENCRYPTION_KEY_CURRENT=v1

MAX_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=50

# Shared rate-limit backend (app/core/rate_limit.py). docker-compose.yml sets
# this itself for the `api` service (its own `redis` service, unrelated to
# this file); required by Settings._require_redis_outside_local anywhere
# ENVIRONMENT is not `local`. Leave unset for local dev -- slowapi falls back
# to an in-memory limiter, correct only for a single process.
REDIS_URL=

# LM Studio's OpenAI-compatible server, running natively on the Windows host
# for GPU access. The container reaches it via Docker Desktop's built-in
# host.docker.internal DNS name -- never localhost.
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_MODEL=local-model
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.0
